{
  "manifest_version": 2,
  "name": "Technic API Build Fix",
  "version": "1.0",
  "description": "Ensures 'build=999' is included in requests to api.technicpack.net",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "*://api.technicpack.net/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{afcd44b5-282c-4bba-aa0b-5a00d7686073}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["background.js"]
  }
}
